# Copy to .env.local and fill in your values.
# .env.local is gitignored and loaded only on the server in Next.js.

# Google Gemini API key (server-side only — do NOT prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest
